{
  "manifest_version": 2,
  "name": "Zen Google dark",
  "version": "2.0",
  "description": "Asks Google for its own dark theme in private browsing.",
  "browser_specific_settings": { "gecko": { "id": "google-dark@zen.android" } },
  "permissions": ["webRequest", "webRequestBlocking", "*://*.google.com/*", "*://*.google.ca/*", "*://*.google.fr/*", "*://*.google.co.uk/*"],
  "background": { "scripts": ["background.js"] }
}
