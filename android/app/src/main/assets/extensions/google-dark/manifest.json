{
  "manifest_version": 2,
  "name": "Zen Android helpers",
  "version": "3.7",
  "description": "Google's own dark theme in private browsing, fullscreen video on rotation, and no sideways scrolling on phone layouts.",
  "browser_specific_settings": { "gecko": { "id": "google-dark@zen.android" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "webRequest", "webRequestBlocking", "*://*.google.com/*", "*://*.google.ca/*", "*://*.google.fr/*", "*://*.google.co.uk/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["orientation.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["overflow.js"],
      "run_at": "document_end"
    }
  ]
}
