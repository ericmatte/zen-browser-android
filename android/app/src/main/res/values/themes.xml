<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="zen_background">#F0F0F4</color>
    <color name="zen_icon_background">#1C1C1C</color>
    <color name="zen_private">#3B2A5C</color>

    <style name="Theme.Zen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/zen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Same colour before, during and after the splash, so launch never flashes. -->
    <style name="Theme.Zen.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Zen</item>
    </style>
</resources>
